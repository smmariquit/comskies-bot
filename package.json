{
  "name": "comskies-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Discord bot for the UPLB ICS Discord server",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "register-commands": "bun src/register-commands.ts",
    "register-commands:prod": "node dist/register-commands.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "lint": "biome check .",
    "check": "biome check . && bun run typecheck && bun test src && bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
